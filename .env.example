# SmartCrack Environment Configuration Example
# Copy this file to .env or ~/.smartcrack/config.json to customize settings.

# Default wordlist used when none is specified in CLI arguments
# SMARTCRACK_DEFAULT_WORDLIST=/usr/share/wordlists/rockyou.txt

# Preferred backend tool: 'hashcat' or 'john'
# SMARTCRACK_PREFERRED_TOOL=hashcat

# Subprocess timeout in seconds (default: 3600)
# SMARTCRACK_TIMEOUT_SECONDS=3600
